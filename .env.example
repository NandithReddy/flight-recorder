# Entirely optional. The project runs end to end on local models via Ollama
# with no key at all — see the README. This file only matters if you want to
# add a hosted provider as an extra row in the config matrix.

# Vercel AI Gateway: one key, every provider. https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Provided automatically on Vercel deployments; listed so the resolution
# order is visible.
# VERCEL_OIDC_TOKEN=
