# Copy to .env and fill in. Nothing here is needed until you want a real
# provider — phases 0 through 3 run against the deterministic mock for free.

# Vercel AI Gateway: one key, every provider. Get one at
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# When deployed on Vercel this is provided automatically and the key above is
# unnecessary. Listed only so the resolution order is visible.
# VERCEL_OIDC_TOKEN=
